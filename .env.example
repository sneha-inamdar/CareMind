# CareMind Supabase & Application Environment Configuration
# Copy this file to .env and fill in your Supabase project credentials.

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-supabase-project.supabase.co

# Supabase Anon API Key (Public key for client requests)
SUPABASE_KEY=your-supabase-anon-key

# Supabase Service Role Key (Private admin key for backend migrations/seeding)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Backend Configuration
PORT=8000
HOST=0.0.0.0
